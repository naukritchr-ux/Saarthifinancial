# ==============================================================================
# TDS API Environment Configuration Template
# Copy this file to .env and fill in your environment-specific credentials.
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration
# Supported DB_TYPE: 'mysql' (Default / Aiven / Managed MySQL) or 'sqlite' (Offline / Local)
# ------------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=defaultdb
DB_PORT=3306

# ------------------------------------------------------------------------------
# Database SSL Settings (Required for cloud-managed MySQL such as Aiven)
# ------------------------------------------------------------------------------
DB_SSL=true
# Set to 'true' in production to enforce TLS verification.
# Only set to 'false' for local/offline testing against self-signed certs.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CA_PATH=./ca.pem

# ------------------------------------------------------------------------------
# Security & API Key
# Header required on client requests: X-API-Key: <API_KEY>
# ------------------------------------------------------------------------------
API_KEY=your_secure_api_key_here

# ------------------------------------------------------------------------------
# CORS Configuration (Comma-separated list of origins or '*' for wildcard)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
