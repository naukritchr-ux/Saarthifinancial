# TDS API Backend Environment Configuration Example

# Server Port
PORT=5000

# Database Configuration ('sqlite' or 'mysql')
DB_TYPE=sqlite
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=saarthi_tds
DB_PORT=3306

# API Key Security
API_KEY=saarthi-secret-api-key-2026
ENFORCE_API_KEY=false

# Allowed Origins for CORS (comma-separated URLs or '*' for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://saarthifinancial-l7f7.vercel.app
