# TDS API Backend Environment Configuration Example (Aiven / Managed MySQL Setup)

# Server Port
PORT=5000

# Database Configuration ('mysql' for Aiven MySQL, or 'sqlite' for local offline testing)
DB_TYPE=mysql
DB_HOST=your-aiven-db-host.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_PORT=10000

# Aiven SSL Settings
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# API Key Security
API_KEY=saarthi-secret-api-key-2026
ENFORCE_API_KEY=false

# Allowed Origins for CORS (comma-separated URLs or '*' for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://saarthifinancial-l7f7.vercel.app
