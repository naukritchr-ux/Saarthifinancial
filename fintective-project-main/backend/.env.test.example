# Example environment configuration for running write-enabled tests safely.
# NOTE: The database name MUST end with '_staging' or '_test'.
#
# Write tests (@pytest.mark.writes_db) are automatically skipped unless the effective
# DB_NAME ends with '_staging' or '_test'.

# Dedicated test/staging database connection URL (ignores DB_HOST, DB_NAME, etc.)
TEST_DATABASE_URL=mysql://test_user:test_password@localhost:3306/crm_db_test

# Testing flag (automatically enabled in conftest.py)
FLASK_TESTING=true

# API Key matching backend API_KEY for authenticated endpoint tests
API_KEY=test-api-key-placeholder
